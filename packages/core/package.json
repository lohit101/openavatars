{
  "name": "openavatars",
  "version": "0.1.0",
  "description": "Deterministic, animated SVG avatars for JavaScript and React. One username, one little character.",
  "type": "module",
  "license": "MIT",
  "sideEffects": false,
  "main": "./dist/cjs/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "import": {
        "types": "./dist/index.d.ts",
        "default": "./dist/index.js"
      },
      "require": {
        "types": "./dist/cjs/index.d.ts",
        "default": "./dist/cjs/index.js"
      }
    },
    "./react": {
      "import": {
        "types": "./dist/react.d.ts",
        "default": "./dist/react.js"
      },
      "require": {
        "types": "./dist/cjs/react.d.ts",
        "default": "./dist/cjs/react.js"
      }
    },
    "./package.json": "./package.json"
  },
  "files": [
    "dist",
    "README.md",
    "LICENSE"
  ],
  "scripts": {
    "build": "node ../../scripts/build-package.mjs",
    "prepack": "npm run build",
    "prepublishOnly": "npm run build"
  },
  "keywords": [
    "avatar",
    "svg",
    "generative",
    "animated",
    "profile",
    "blob",
    "react",
    "typescript",
    "profile-picture",
    "deterministic"
  ],
  "author": "Lohit",
  "homepage": "https://github.com/lohit101/openavatars#readme",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/lohit101/openavatars.git",
    "directory": "packages/core"
  },
  "bugs": {
    "url": "https://github.com/lohit101/openavatars/issues"
  },
  "module": "./dist/index.js",
  "publishConfig": {
    "access": "public",
    "registry": "https://registry.npmjs.org/"
  },
  "peerDependencies": {
    "react": "^18.0.0 || ^19.0.0"
  },
  "peerDependenciesMeta": {
    "react": {
      "optional": true
    }
  }
}
